# Translator Memory Engine - Environment Variables
# Copy this file to .env and fill in your API keys

# Groq API key (used by the default high-quality prose rewrite model)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional rewrite overrides. Defaults to Groq llama-3.3-70b-versatile.
# REWRITE_LLM_BASE_URL=https://api.groq.com/openai/v1
# REWRITE_LLM_MODEL=llama-3.3-70b-versatile
# REWRITE_LLM_TEMPERATURE=0.25
# REWRITE_LLM_MAX_TOKENS=3072

# Optional local OpenAI-compatible endpoint for cheap policy verification.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=your-quantized-model
# LOCAL_LLM_API_KEY=sk-no-key-required

# Gemini API key (optional, for judge evaluation)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace telemetry (set to 1 to disable)
HF_HUB_DISABLE_TELEMETRY=1
